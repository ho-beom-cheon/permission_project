# Copy this file to .env.oracle.local and replace both passwords.
# Never commit .env.oracle.local.
ORACLE_ADMIN_PASSWORD=replace-with-a-local-admin-password
PM_DB_USERNAME=PM_APP
PM_DB_PASSWORD=replace-with-a-local-application-password

# Spring Boot connection values
PM_DB_URL=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
